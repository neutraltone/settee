<!--
  The debug build's own launcher label (#244), so it can't be mistaken for the release build it
  installs beside. Only the launcher entry changes: in-app text keeps app_name's "Settee".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="@string/launcher_label_debug"
        tools:replace="android:label" />
</manifest>
