<!--
  The local release build's own launcher label: a release build made on a Mac without the release
  keystore (app/build.gradle.kts, isLocalRelease), installed beside the real release and the debug
  build. Only the launcher entry changes: in-app text keeps app_name's "Settee".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="@string/launcher_label_local"
        tools:replace="android:label" />
</manifest>
